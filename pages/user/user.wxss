.user-container {
    padding-top: 30rpx;
    min-height: 100vh;
    background-color: #f5f5f5;
    position: relative;
}

/* AI推荐功能 */
.ai-recommendation {
    margin: 0 20rpx 20rpx;
    padding: 25rpx;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    border-radius: 12rpx;
    box-shadow: 0 4rpx 15rpx rgba(102, 126, 234, 0.3);
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.ai-icon {
    font-size: 48rpx;
    margin-right: 20rpx;
}

.ai-content {
    flex: 1;
}

.ai-title {
    font-size: 32rpx;
    font-weight: bold;
    color: #fff;
    display: block;
    margin-bottom: 5rpx;
}

.ai-desc {
    font-size: 24rpx;
    color: rgba(255, 255, 255, 0.8);
    display: block;
}

.ai-arrow {
    font-size: 48rpx;
    color: #fff;
    font-weight: bold;
}

/* 用户偏好设置 */
.preference-setting {
    margin: 0 20rpx 20rpx;
    padding: 25rpx;
    background-color: #fff;
    border-radius: 10rpx;
    box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.preference-item {
    margin-top: 20rpx;
    padding-top: 20rpx;
    border-top: 1rpx solid #f0f0f0;
}

.preference-label {
    font-size: 28rpx;
    color: #333;
    font-weight: 500;
    display: block;
    margin-bottom: 15rpx;
}

.time-slots {
    display: flex;
    flex-wrap: wrap;
    gap: 15rpx;
}

.time-slot {
    padding: 15rpx 30rpx;
    background-color: #f5f5f5;
    border-radius: 25rpx;
    font-size: 26rpx;
    color: #666;
    transition: all 0.3s;
}

.time-slot.active {
    background-color: #667eea;
    color: #fff;
}

.campus-list {
    display: flex;
    flex-wrap: wrap;
    gap: 10rpx;
}

.campus-item {
    padding: 12rpx 24rpx;
    background-color: #f5f5f5;
    border-radius: 20rpx;
    font-size: 26rpx;
    color: #666;
    transition: all 0.3s;
}

.campus-item.active {
    background-color: #667eea;
    color: #fff;
}

.version-tag {
    margin: 10rpx 20rpx;
    font-size: 24rpx;
    color: #999;
    background-color: #fff;
    padding: 8rpx 16rpx;
    border-radius: 20rpx;
    box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

/* 消息提醒设置 */
.notification-setting {
    margin: 0 20rpx 20rpx;
    padding: 25rpx;
    background-color: #fff;
    border-radius: 10rpx;
    box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.setting-header {
    margin-bottom: 20rpx;
}

.setting-title {
    font-size: 32rpx;
    font-weight: bold;
    color: #333;
    display: block;
    margin-bottom: 5rpx;
}

.setting-desc {
    font-size: 24rpx;
    color: #666;
    display: block;
}

.toggle-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 10rpx;
}

.toggle-label {
    font-size: 28rpx;
    color: #666;
    margin-left: 20rpx;
}

.first_line {
    display: flex;
    align-items: center;
    margin: 0 20rpx 20rpx;
}

.first_line .sort-btn {
    margin: 10rpx 0 10rpx auto; 
    font-size: 28rpx;
    color: #1aad19;
    padding: 20rpx;
    background-color: #f0f9ff;
    border-radius: 8rpx;
}

.first_line .station-tip {
    margin: 10rpx auto 10rpx 0; 
    font-size: 28rpx;
    color: #666;
    padding: 20rpx;
    text-align: center;
    border-radius: 10rpx;
}

/* 用户页面内容 */
.user-content {
    padding: 0 20rpx 20rpx;
}

/* 空收藏状态 */
.empty-container {
    text-align: center;
    padding: 100rpx 0;
    background-color: #fff;
    border-radius: 10rpx;
    box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.empty-text {
    font-size: 32rpx;
    color: #666;
    margin-bottom: 20rpx;
}

/* 收藏列表 */
.station-list {
}

/* 加载状态 */
.loading {
    text-align: center;
    padding: 50rpx 0;
    font-size: 28rpx;
    color: #1aad19;
}