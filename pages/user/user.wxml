<!--pages/user/user.wxml-->
<view class="user-container">
  <!-- AI推荐功能 -->
  <view class="ai-recommendation" bindtap="getAIRecommendation">
    <view class="ai-icon">🤖</view>
    <view class="ai-content">
      <text class="ai-title">AI智能推荐</text>
      <text class="ai-desc">根据您的偏好和充电桩使用情况智能推荐</text>
    </view>
    <view class="ai-arrow">›</view>
  </view>

  <!-- 用户偏好设置 -->
  <view class="preference-setting">
    <view class="setting-header">
      <text class="setting-title">充电偏好</text>
      <text class="setting-desc">设置您的充电习惯，获得更精准的推荐</text>
    </view>
    
    <!-- 时间段偏好 -->
    <view class="preference-item">
      <text class="preference-label">偏好充电时段</text>
      <view class="time-slots">
        <view 
          class="time-slot {{preferredTimeSlots.includes('morning') ? 'active' : ''}}" 
          bindtap="toggleTimeSlot" 
          data-slot="morning">
          <text>上午</text>
        </view>
        <view 
          class="time-slot {{preferredTimeSlots.includes('afternoon') ? 'active' : ''}}" 
          bindtap="toggleTimeSlot" 
          data-slot="afternoon">
          <text>下午</text>
        </view>
        <view 
          class="time-slot {{preferredTimeSlots.includes('evening') ? 'active' : ''}}" 
          bindtap="toggleTimeSlot" 
          data-slot="evening">
          <text>晚上</text>
        </view>
        <view 
          class="time-slot {{preferredTimeSlots.includes('night') ? 'active' : ''}}" 
          bindtap="toggleTimeSlot" 
          data-slot="night">
          <text>夜间</text>
        </view>
      </view>
    </view>

    <!-- 校区偏好 -->
    <view class="preference-item">
      <text class="preference-label">偏好校区</text>
      <view class="campus-list">
        <view 
          class="campus-item {{preferredCampuses.includes('紫金港校区') ? 'active' : ''}}" 
          bindtap="toggleCampus" 
          data-campus="紫金港校区">
          <text>紫金港</text>
        </view>
        <view 
          class="campus-item {{preferredCampuses.includes('玉泉校区') ? 'active' : ''}}" 
          bindtap="toggleCampus" 
          data-campus="玉泉校区">
          <text>玉泉</text>
        </view>
        <view 
          class="campus-item {{preferredCampuses.includes('西溪校区') ? 'active' : ''}}" 
          bindtap="toggleCampus" 
          data-campus="西溪校区">
          <text>西溪</text>
        </view>
        <view 
          class="campus-item {{preferredCampuses.includes('华家池校区') ? 'active' : ''}}" 
          bindtap="toggleCampus" 
          data-campus="华家池校区">
          <text>华家池</text>
        </view>
        <view 
          class="campus-item {{preferredCampuses.includes('之江校区') ? 'active' : ''}}" 
          bindtap="toggleCampus" 
          data-campus="之江校区">
          <text>之江</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 消息提醒设置 -->
  <view class="notification-setting">
    <view class="setting-header">
      <text class="setting-title">消息提醒</text>
      <text class="setting-desc">当收藏的充电桩有空闲时通知我</text>
    </view>
    <view class="toggle-container">
      <switch checked="{{notificationEnabled}}" bindchange="toggleNotification" color="#4CAF50" />
      <text class="toggle-label">{{notificationEnabled ? '已开启' : '已关闭'}}</text>
    </view>
  </view>
  
  <!-- 第一行的提示信息 -->
  <view class="first_line">
    <view class="station-tip">
      <text>收藏了 {{favoriteStations.length}} 个充电桩</text>
    </view>
    <view class="version-tag">v1.0.5</view>
    <view class="sort-btn" bindtap="changeSort">
      <text>{{sortText[sortBy]}}</text>
    </view>
  </view>
  
  <view class="user-content">
    <view class="station-list" wx:if="{{favoriteStations.length > 0}}">
      <view wx:for="{{favoriteStations}}" wx:key="hash_id" bindtap="goDetail" data-item="{{item}}">
        <charger-item item="{{item}}" />
      </view>
    </view>
    
    <view class="empty-container" wx:else>
      <text class="empty-text">暂无收藏的充电桩</text>
    </view>
  </view>
</view>