/* pages/ai-recommendation/ai-recommendation.wxss */
.container {
  min-height: 100vh;
  background-color: #f5f5f5;
}

.header {
  display: flex;
  align-items: center;
  padding: 30rpx 20rpx;
  background-color: #fff;
  border-bottom: 1rpx solid #e0e0e0;
  position: sticky;
  top: 0;
  z-index: 100;
}

.back-btn {
  margin-right: 20rpx;
}

.back-icon {
  font-size: 48rpx;
  color: #333;
}

.title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  flex: 1;
  text-align: center;
  margin-right: 60rpx;
}

.content {
  padding: 20rpx;
}

.section {
  background-color: #fff;
  border-radius: 12rpx;
  padding: 25rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}

/* 校区选择 */
.campus-list {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
}

.campus-item {
  padding: 16rpx 32rpx;
  background-color: #f5f5f5;
  border-radius: 25rpx;
  font-size: 26rpx;
  color: #666;
  transition: all 0.3s;
}

.campus-item.active {
  background-color: #07C160;
  color: #fff;
}

/* 时间段选择 */
.time-slot-list {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
}

.time-slot-item {
  padding: 16rpx 32rpx;
  background-color: #f5f5f5;
  border-radius: 25rpx;
  font-size: 26rpx;
  color: #666;
  transition: all 0.3s;
}

.time-slot-item.active {
  background-color: #07C160;
  color: #fff;
}

/* 充电时长设置 */
.duration-slider {
  margin-top: 10rpx;
}

.duration-value {
  font-size: 26rpx;
  color: #07C160;
  font-weight: 500;
  margin-bottom: 20rpx;
  display: block;
  text-align: center;
}

/* 生成推荐按钮 */
.generate-btn {
  background-color: #07C160;
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 10rpx;
  padding: 25rpx;
  margin-top: 40rpx;
  margin-bottom: 40rpx;
}

.generate-btn::after {
  border: none;
}
