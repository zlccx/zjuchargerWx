/* pages/detailPlus/detailPlus.wxss */
.detail-plus-container {
    width: 100%;
    height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    background-color: #f8f9fa;
}

/* 地图容器样式 */
.map-container {
    width: 90vw;
    height: 40vh;
    margin-top: 15rpx;
    border-radius: 30rpx;
    box-shadow: 0 8rpx 25rpx rgba(0, 0, 0, 0.08);
    overflow: hidden;
}

/* 地图样式 */
.map {
    width: 100%;
    height: 100%;
}

/* 设备列表区域 */
.devices-container {
    width: 90vw;
    flex: 1;
    background-color: #ffffff;
    border-radius: 30rpx;
    margin: 30rpx 0;
    padding: 40rpx;
    box-shadow: 0 -8rpx 25rpx rgba(0, 0, 0, 0.08);
    overflow-y: auto;
}

/* 区域标题 */
.section-title {
    font-size: 32rpx;
    font-weight: bold;
    color: #1a1a1a;
    margin-bottom: 30rpx;
    text-align: center;
}

/* 设备列表 */
.devices-list {
    display: flex;
    flex-direction: column;
    gap: 25rpx;
}

/* 操作按钮容器 */
.action-buttons {
    display: flex;
    justify-content: space-between;
    margin-top: 40rpx;
    gap: 20rpx;
}

/* 导航按钮 */
.navigation-btn {
    flex: 1;
    display: flex;
    justify-content: center;
    align-items: center;
    background-color: #1989fa;
    color: white;
    padding: 25rpx 0;
    border-radius: 20rpx;
    cursor: pointer;
    transition: all 0.3s ease;
}

.navigation-btn:active {
    background-color: #0c7cec;
    transform: scale(0.98);
}

.nav-icon {
    width: 36rpx;
    height: 36rpx;
    margin-right: 15rpx;
}

.nav-text {
    font-size: 30rpx;
    font-weight: bold;
}

/* 提交位置按钮 */
.submit-location-btn {
    flex: 1;
    display: flex;
    justify-content: center;
    align-items: center;
    background-color: #07c160;
    color: white;
    padding: 25rpx 0;
    border-radius: 20rpx;
    cursor: pointer;
    transition: all 0.3s ease;
}

.submit-location-btn:active {
    background-color: #06ad56;
    transform: scale(0.98);
}

.submit-text {
    font-size: 30rpx;
    font-weight: bold;
}

/* 响应式设计 */
@media (max-width: 375px) {
    .section-title {
        font-size: 28rpx;
    }
    
    .nav-icon {
        width: 32rpx;
        height: 32rpx;
    }
    
    .nav-text {
        font-size: 28rpx;
    }
}